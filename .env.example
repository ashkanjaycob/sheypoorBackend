# ---------- App ----------
PORT=3405
NODE_ENV=development

# ---------- MySQL (local / docker-compose) ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sheypoor
MYSQL_PASSWORD=sheypoor
MYSQL_DATABASE=sheypoor

# ---------- MySQL (production) ----------
# اگر ست شود، متغیرهای بالا نادیده گرفته می‌شوند
# DATABASE_URL=mysql://user:pass@host:3306/dbname
# DB_SSL=true

# لاگ کوئری‌های SQL
DB_LOGGING=false
# فقط در توسعه: تغییر ساختار جداول موجود
DB_SYNC_ALTER=false

# ---------- Auth ----------
JWT_SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECRET_KEY=change-me-too

# ---------- Map (map.ir) ----------
MAP_IR_URL=https://map.ir/reverse
MAP_API_KEY=

# ---------- SMS (melipayamak) ----------
# اگر خالی باشد، در حالت توسعه کد OTP فقط در کنسول چاپ می‌شود
MELI_TOKEN=
